# ─── Copy this file to .env and fill in real values ───────────────────────────

# PostgreSQL admin password (used by docker-compose postgres service)
POSTGRES_ADMIN_PASSWORD=sp_admin_pass

# OpenRouter API key  →  https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# OpenRouter model to use for the LangGraph agent.
# Any model listed on https://openrouter.ai/models works here, e.g.:
#   openai/gpt-4o-mini          ← default (fast, cheap, good tool-calling)
#   openai/gpt-4o               ← stronger reasoning
#   anthropic/claude-3.5-sonnet ← best quality
#   meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: your app name shown in OpenRouter dashboard
OPENROUTER_APP_NAME=shipment-planner

# Apollo Studio key (optional – for schema checks / usage reporting)
APOLLO_KEY=
APOLLO_GRAPH_REF=
